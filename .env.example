# Backend base URL. Without this set, the app calls the API on its own
# page origin (window.location.origin) — fine once the frontend is served
# from the same host/proxy as the backend. For local dev (`npm run dev`,
# served from localhost:5173, which is NOT the backend), copy this file to
# .env and point this at wherever the backend actually is, e.g. a pinggy
# tunnel URL or http://localhost:8080.
VITE_API_BASE_URL=https://your-backend.example.com
